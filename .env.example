# ===========================================================================
# 自动询价系统 · 环境变量模板
#   复制成 .env 后按需修改。原生启动时脚本会自动读取本目录下的 .env。
# ===========================================================================

# ---------- 服务 ----------
APP_HOST=0.0.0.0
# ★ 端口只在这一处配：API、前端、SSO 回调、启动脚本、开发代理全都跟着走
APP_PORT=6900

# ---------------------------------------------------------------------------
# 飞书（全自动比价结束后推送「比价表总结 + 比价表 CSV」）
#   应用机器人模式（推荐，能发文件）：
#     FEISHU_APP_ID / FEISHU_APP_SECRET  取自飞书开放平台自建应用
#     FEISHU_CHAT_ID                     默认接收群；也可用 FEISHU_GROUP_WHITELIST 配多个（逗号分隔）
#   自定义机器人兜底（只能发文本，发不了文件）：FEISHU_WEBHOOK_URL
#
# 作业失败告警（队列里的作业失败时推一张红色卡片；界面上还有全局告警条 + 日志中心详情）：
#   FEISHU_ALERT_ENABLED   false 可整体关掉
#   FEISHU_ALERT_CHAT_ID   告警群；留空 = 跟上面的 FEISHU_CHAT_ID 同一个群
# ---------------------------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_GROUP_WHITELIST=
FEISHU_WEBHOOK_URL=
FEISHU_ALERT_ENABLED=true
FEISHU_ALERT_CHAT_ID=
SEND_MODE=send
REQUIRE_SEND_CONFIRM=true
QUEUE_AUTOSTART=true

# 新消息事件泵：monitor 写入 events 表后，队列空闲时自动触发单会话采集
# 忙时跳过，避免和全自动/调度作业重复抢浏览器
EVENT_PUMP_ENABLED=true
EVENT_PUMP_INTERVAL_SEC=5
EVENT_PUMP_MAX_AGE_SEC=1800
BRIDGE_TIMEOUT=600

# ---------- 路径（默认自动推导，只有搬家时才需要改）----------
# PROJECT_ROOT=E:\ZY2026\cg_002-26.9.17-1688比价议价
# QIANNIU_DIR=%PROJECT_ROOT%\tools\qianniu
# IM_DB=%QIANNIU_DIR%\data\im.db
# BRIDGE_SCRIPT=%PROJECT_ROOT%\tools\api\bridge.mjs
# IMAGE_DIR=%QIANNIU_DIR%\image
# PHRASE_LIB=%QIANNIU_DIR%\phrase-library.json
# API_DB=<本目录>\data\api.db
# FRONTEND_DIST=<本目录>\frontend\dist

# ---------- Chrome 调试端口 ----------
CDP_BASE=http://127.0.0.1:6901
# 「状态监控」页面一键启停用：
#   CHROME_PROFILE_DIR       调试实例的独立 profile（必须与 tools/qianniu/start-im.ps1 一致，
#                            否则"拉起的实例"和"能关掉的实例"不是同一个）
#   CHROME_EXE               chrome.exe 的完整路径；留空 = 自动检测。
#                            ★ 优先级：状态监控页面里保存的设置 > 这个环境变量 > 自动检测
#   BROWSER_START_URL        一键启动浏览器时打开的页面
#   BROWSER_CONTROL_SCRIPT   启停脚本位置（一般不用改）
# CHROME_PROFILE_DIR=%LOCALAPPDATA%\1688-cdp-profile
# CHROME_EXE=C:\Program Files\Google\Chrome\Application\chrome.exe
# BROWSER_START_URL=https://work.1688.com/
# BROWSER_CONTROL_SCRIPT=<本目录>\deploy\browser-control.ps1

# ---------- 常驻监听 ----------
MONITOR_INTERVAL_SEC=15
MONITOR_REFRESH_MIN=0

# ---------- Windows 宿主控制代理（容器部署必配）----------
# 在 Windows 用户桌面会话中运行：
#   .\deploy\start-host-agent.ps1
# 首次启动会自动生成 HOST_AGENT_TOKEN 写入本文件。
# 代理默认监听 0.0.0.0:7400，让 Docker Desktop 通过 host.docker.internal 访问；
# 令牌是访问凭证，7400 对外网暴露时应由防火墙限制来源。
HOST_AGENT_BIND=0.0.0.0
HOST_AGENT_PORT=7400
HOST_AGENT_TOKEN=
HOST_AGENT_STATUS_INTERVAL_SEC=2
HOST_AGENT_SNAPSHOT_INTERVAL_SEC=2
# HOST_AGENT_URL 只在容器里配置，宿主代理进程不能配置它：
# HOST_AGENT_URL=http://host.docker.internal:7400

# ===========================================================================
# 企业门户 SSO（★ 必填，否则登录会失败）
# ===========================================================================
# ★ 必须与门户 .env 中的 JWT_SECRET 完全一致
JWT_SECRET=change-me-in-production-please-use-random-string
JWT_ALGORITHM=HS256

# ★ 门户统一对外入口（6690 是反向代理入口；6680/6681 是容器内部端口）
PORTAL_API_BASE_URL=http://192.168.40.194:6690
SSO_LOGIN_URL=http://192.168.40.194:6690/login
# 本应用对外访问地址（浏览器实际访问的地址），必须与门户里注册的应用同源
SSO_CALLBACK_URL=http://192.168.0.193:6900/api/auth/sso/callback
SSO_TOKEN_COOKIE_NAME=jwt_token
SSO_COOKIE_SECURE=false
SSO_COOKIE_MAX_AGE=28800
# 点"退出登录"时跳转的门户登出地址：先清本应用会话，再退掉门户会话。
# 不配的话，退出后进别的接入应用会被门户静默登回来。
PORTAL_LOGOUT_URL=http://192.168.40.194:6690/logout

# ---------- 本地调试登录（门户未就绪时用；生产建议 false）----------
ALLOW_DEV_LOGIN=true
DEV_ADMIN_USER=admin
DEV_ADMIN_PASSWORD=admin123
DEV_GM_USER=gm
DEV_GM_PASSWORD=gm123
DEV_USER_USER=user
DEV_USER_PASSWORD=user123

# ---------- 跨域（默认关闭；前端与 API 同源，一般不需要）----------
# CORS_ORIGINS=http://127.0.0.1:6905

# ---------- 侧边栏底部的开发者入口与版权 ----------
# 注意：侧边栏那个入口指向本系统自己的 /developer 页面（复刻的门户页面），
# 不是外链；DEVELOPER_URL 只记录门户端同名页面的地址，供参考。
DEVELOPER_URL=http://192.168.40.194:6690/developer
DEVELOPER_NAME=IT · HZX-钟元
COPYRIGHT=© IT · 汇挚鑫企业应用门户

# ---------- 容器部署时用（见 deploy/docker-compose.yml）----------
# PROJECT_ROOT=/app/project
# API_DB=/app/data/api.db
# IM_DB=/app/data/im.snapshot.db
# CDP_BASE=http://host.docker.internal:6901
